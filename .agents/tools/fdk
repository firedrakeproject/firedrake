# gh pr edit reads the project fields, which fail on a repository that still
# carries a classic project. The REST API does not read them.
done = subprocess.run(["gh", "api", "-X", "PATCH",
                       f"repos/{repo.stdout.strip()}/pulls/{number}", "--input", "-"],
                      input=json.dumps(payload), capture_output=True, text=True)
if done.returncode:
    sys.exit(done.stderr.strip())
result = json.loads(done.stdout)
print(f"#{result['number']} {result['title']}")
print(result["html_url"])
